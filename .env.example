APP_NAME=       # REQUIRED: part_source_pipeline (underscore — the logger's container path)
ENV='prod'
LOGGER='prod'    # 'dev' adds console error stacks + run stats; file/DB sinks unaffected

# Host side of the run-log mount. Dev default (unset -> ./utils/logger/logs)
# FAILS SAFE: dev noise never lands in the production record. The #RELEASE:
# line is applied to the deployed .env by build-release.sh.
LOG_DIR=./utils/logger/logs
#RELEASE:LOG_DIR=/opt/run-logs/part-source-pipeline

## Local Docker PG
PGHOST=pg_db
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=      # REQUIRED: <DB_NAME> per the setup doc identity table (dev / staging / prod)
PG_SSLMODE=require
PG_SSL_PATH=/opt/resources/ssl/pg_ssl.crt

# PROD DATABASE
# PG_PORT=
# PG_USER=
# PG_PW=
# PG_DB=
# PG_HOST=
# PG_SSL_PATH=


# Production API Login
PROD_LOGIN_URI=
PROD_LOGIN_NAME=
PROD_LOGIN_PW=
PROD_LOGIN_COMPANY=

# Production Equipment API
HCA_URI=
HCA_TECH=
HCA_INVOICE=
HCA_CONTRACT_DETAILS=
# Consumed by jobs/sync-hca.js as HCA_SRV_ORDER_DETAILS (HCAServiceData endpoint)
HCA_SRV_ORDER_DETAILS=

# Avante_Biomed_Inventory.csv
INV_FEED=
# Avante_Imaging_Inventory.csv
INV_FEED_2=

# --- RETIRED (superseded by the endpoints above; kept for reference only) ---
# HCA_URI=
# INV_FEED=
# INV_FEED_2=
# INV_FEED_AHS_DEV_1=
# INV_FEED_AHS_DEV_2=

# SFTP SERVER
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASS=
# sftp avante01@ps-sftp.partssource.com
# sftp -P 22 avante01@ps-sftp.partssource.com
# pw: <in secret store — never commit real values>

## ---- host identity (differs per host; never hardcode in tracked files) ----
## staging: DOCKER_GID=987 UID_0=105 | dev: DOCKER_GID=990 UID_0=104
DOCKER_GID=      # REQUIRED: getent group docker | cut -d: -f3  (host identity is per-server — REL-07)
UID_0=           # REQUIRED: id -u svc
UID_1=           # REQUIRED: id -u <admin user 1>
UID_2=           # REQUIRED: id -u <admin user 2>
# RUN_USER is intentionally NOT set here: entrypoint.sh defaults to svc, so one
# place decides the production identity. Dev runs pass it on the command line.

# USER_ID drives the image tag (psp:${USER_ID}): your username in a dev clone,
# svc in the release copy. The #RELEASE: line is applied to the DEPLOYED .env
# by build-release.sh; keep both lines in the dev tree.
USER_ID=         # REQUIRED: your username in a dev clone
#RELEASE:USER_ID=svc
